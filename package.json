{
  "name": "dsh-macos-automation",
  "version": "0.2.0",
  "description": "把 macOS 桌面变成模型可用的一组工具：发现 UI 元素、点击、输入、快捷键、窗口/应用/菜单/剪贴板/OCR。基于 Accessibility 与 CGEvent 的原生 CLI。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts/build-cli.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "macos",
    "automation",
    "accessibility",
    "gui-agent",
    "computer-use"
  ],
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.10.0",
    "rolldown": "^1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "prepare": "npm run build",
    "prepack": "npm run check && npm run build",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutumnFruit-1999/dsh-macos-automation.git"
  },
  "homepage": "https://github.com/AutumnFruit-1999/dsh-macos-automation#readme",
  "bugs": {
    "url": "https://github.com/AutumnFruit-1999/dsh-macos-automation/issues"
  }
}
